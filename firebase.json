{
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "database.rules.json",
      ".firebase",
      ".git"
    ],
    "rewrites": [
      { "source": "/admin", "destination": "/admin.html" }
    ],
    "headers": [
      {
        "source": "**/*.js",
        "headers": [{
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }]
      },
      {
        "source": "**/*.html",
        "headers": [{
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }]
      }
    ]
  },
  "database": {
    "rules": "database.rules.json"
  }
}