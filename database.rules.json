{
  "rules": {
    ".read": "auth != null",
    ".write": "auth != null",
    "users": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && ($uid === auth.uid || auth.token.email === 'brian.bcyang27@gmail.com')"
      }
    },
    "leaderboard": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["score"]
    },
    "lobbies": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$lobbyId": {
        "players": {
          "$uid": {
            ".write": "auth != null && $uid === auth.uid"
          }
        }
      }
    }
  }
}